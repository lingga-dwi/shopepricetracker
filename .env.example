# Telegram Bot untuk notifikasi harga
# Buat bot via @BotFather di Telegram, lalu isi token di bawah
TELEGRAM_BOT_TOKEN=
# Chat ID tujuan notifikasi (bisa didapat dari @userinfobot)
TELEGRAM_CHAT_ID=

# Port Chrome remote debugging (CDP)
CDP_PORT=9222

# Jeda antar cek produk (detik)
DELAY_BETWEEN_PRODUCTS=10

# Jam scheduler cek harga otomatis (format 24 jam, pisah koma)
SCHEDULE_HOURS=09:00,14:00,20:00
